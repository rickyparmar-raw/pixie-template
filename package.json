  "packageManager": "bun@1.3.13",
  "dependencies": {
    "@slack/bolt": "^4.7.3",
    "axios": "^1.16.1",
    "dotenv": "^17.4.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
