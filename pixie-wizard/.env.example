# Supabase project holding pixie_trials / railway_account_pool / trial_events.
# Can be the same Pixl project the game server uses, or its own project —
# either way this table holds live secrets, see lib/db's callers.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=service-role-key

# Hack Club Auth (https://auth.hackclub.com):
#  - Create an OAuth app at https://auth.hackclub.com/apps
#  - Redirect URI: <BASE_URL>/api/auth/callback
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=

# Comma-separated HCA identity ids/emails/domains allowed to start a trial.
# Empty means anyone with a Hack Club Auth account — see plan §5 before
# leaving this unset in production.
PIXIE_WIZARD_ALLOWLIST=

# Long random string for signing session cookies
SESSION_SECRET=

# 32-byte AES-256 key, base64-encoded, for encrypting Railway tokens and
# per-trial Slack/LLM secrets at rest (lib/crypto.ts). Generate with:
#   openssl rand -base64 32
WIZARD_ENCRYPTION_KEY=

# Where this app runs (used for the Hack Club Auth redirect)
BASE_URL=http://localhost:4901

# Set to skip real Railway calls during provisioning — logs the mutations it
# would send (secrets redacted) and fabricates success instead.
# WIZARD_DRY_RUN=1

# Guards the daily lifecycle sweep cron (vercel.json). Unset means the cron
# route is reachable by anyone who finds the URL — same fail-open shape as
# apps/dashboard's own CRON_SECRET, set it before this app is public.
CRON_SECRET=

# Trial expiry/reclaim emails (Resend). Leave both empty to skip email
# entirely — the sweep still runs, it just can't reach anyone by email. A
# Slack DM through the trial's own bot token is attempted first regardless
# (lib/notify.ts) when the trial has a requester Slack id.
RESEND_API_KEY=
EMAIL_FROM=Pixie <team@pixl.rsvp>
